PORT=3001
HOST=127.0.0.1
# Frontend dev origin allowed by CORS (no wildcard). Confirm in task 1.
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Server-only secret. Never expose in responses or logs.
ROUTE_API_KEY=
# --- 네이버 검색: 지역(Local) API. 서버 전용 ---
# NCP 콘솔(NAVER API HUB) 키: 아래 주소. 옛 developers.naver.com 키: https://openapi.naver.com/v1/search/local.json
NAVER_SEARCH_LOCAL_URL=https://naverapihub.apigw.ntruss.com/search/v1/local
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=
# --- NCP Maps: Geocoding(주소 -> 좌표). 서버 전용 ---
NCP_GEOCODE_URL=https://maps.apigw.ntruss.com/map-geocode/v2/geocode
NCP_MAPS_API_KEY_ID=
NCP_MAPS_API_KEY=
# 상영 데이터: sample(샘플 영화·영화관·회차) | real(TMDB 영화 + 인허가 CSV 영화관 + 데모 회차)
SHOWTIME_PROVIDER=sample
ROUTE_PROVIDER=mock
# --- SHOWTIME_PROVIDER=real 일 때 ---
# TMDB v4 읽기 토큰(eyJ...) 또는 v3 API 키. 서버 전용.
TMDB_API_KEY=
TMDB_API_URL=https://api.themoviedb.org/3
TMDB_IMAGE_URL=https://image.tmdb.org/t/p/w342
# 지방행정 인허가 "문화_영화상영관" CSV (backend/ 기준 상대 경로 또는 절대 경로)
CINEMA_CSV_PATH=data/cinemas.csv

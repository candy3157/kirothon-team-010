# 영화관 추천 API 호출 예제 (VS Code REST Client / JetBrains HTTP Client)
# 서버: cd backend; $env:PORT="3001"; npm run dev
@base = http://127.0.0.1:3001

### 서버 상태
GET {{base}}/api/health

### 영화 목록 (오늘 상영 중)
GET {{base}}/api/movies

### 영화 검색
GET {{base}}/api/movies?query=%EC%83%98%ED%94%8C

### 상영 여부: 상영 중 (movie_001)
GET {{base}}/api/movies/movie_001/availability

### 상영 여부: 미상영 (movie_003)
GET {{base}}/api/movies/movie_003/availability

### 상영 여부: 알 수 없는 영화 -> 404 movie_not_found
GET {{base}}/api/movies/movie_999/availability

### 상영 여부: 오늘이 아닌 날짜 -> 400 unsupported_date
GET {{base}}/api/movies/movie_001/availability?date=2000-01-01

### 추천 계산 (departureTime 생략 = 지금)
# @name recommend
POST {{base}}/api/recommendations
Content-Type: application/json

{
  "movieId": "movie_001",
  "origin": { "latitude": 37.5, "longitude": 127 },
  "transportMode": "transit",
  "sortBy": "balanced"
}

### 정렬만 변경 (경로 재조회 없음)
@resultId = {{recommend.response.body.meta.resultId}}
GET {{base}}/api/recommendations/{{resultId}}?sortBy=earliest

### 정렬 변경: 이동시간 순
GET {{base}}/api/recommendations/{{resultId}}?sortBy=travel

### 추천: 미상영 영화 (경로 호출 없이 outcome=not_showing)
POST {{base}}/api/recommendations
Content-Type: application/json

{
  "movieId": "movie_003",
  "origin": { "latitude": 37.5, "longitude": 127 },
  "transportMode": "transit"
}

### 추천: 서울에서 부산 영화관 (직선거리 하한으로 도착 불가 가능)
POST {{base}}/api/recommendations
Content-Type: application/json

{
  "movieId": "movie_004",
  "origin": { "latitude": 37.5, "longitude": 127 },
  "transportMode": "walk"
}

### 추천: 거리 제한 필드는 거부 -> 400 invalid_request
POST {{base}}/api/recommendations
Content-Type: application/json

{
  "movieId": "movie_001",
  "origin": { "latitude": 37.5, "longitude": 127 },
  "transportMode": "car",
  "radiusKm": 10
}

### 만료·없는 결과 -> 404 result_expired
GET {{base}}/api/recommendations/res_doesnotexist1

# API 주소. 비워 두면 같은 origin(/api)으로 요청하고, 개발 중에는 Vite가 127.0.0.1:3001로 프록시한다.
# 배포 시 백엔드가 다른 주소에 있으면 지정한다. 예: https://api.example.com
VITE_API_BASE=

# --- 네이버 지도(NCP Maps, Dynamic Map) ---
# VITE_ 값은 브라우저에 그대로 노출된다. Client ID(ncpKeyId)만 넣고 Secret은 절대 넣지 않는다.
# NCP 콘솔에서 Web 서비스 URL(http://127.0.0.1:5173, http://localhost:5173)을 등록해야 동작한다.
VITE_NAVER_MAP_SCRIPT_URL=https://oapi.map.naver.com/openapi/v3/maps.js
VITE_NAVER_MAP_KEY_ID=
